# EXEC_07 EndTop smoke run near the left edge at x=-650 mm.
/control/verbose 0
/run/verbose 0
/event/verbose 0
/tracking/verbose 0

/det/readout EndTop
/det/scintillator OPSC-101
/sipm/model AFBR-S4N66P024M
/run/initialize

/sipm/jitterSigma 0 ns
/gun/particle mu-
/gun/energy 1 GeV
/muon/angle 0
/muon/gunX -650 mm
/run/beamOn 50
