# macros/diag_scan5.mac — scan rapido de 5 posiciones para diagnostico
# Uso: ./build/ej200_bar_sim -m macros/diag_scan5.mac
# 5 posiciones x 200 eventos: x = -600, -300, 0, +300, +600 mm

/control/verbose 0
/run/verbose     0
/event/verbose   0
/tracking/verbose 0

/run/initialize

/gun/particle mu-
/gun/energy   1 GeV
/muon/angle   0

/muon/gunX -600 mm
/run/beamOn 200

/muon/gunX -300 mm
/run/beamOn 200

/muon/gunX    0 mm
/run/beamOn 200

/muon/gunX  300 mm
/run/beamOn 200

/muon/gunX  600 mm
/run/beamOn 200
