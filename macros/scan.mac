# ============================================================
# scan.mac — longitudinal scan along the bar (x-axis)
# Usage: ./ej200_bar_sim -m macros/scan.mac
# ============================================================

/control/verbose 0
/run/verbose     0
/event/verbose   0
/tracking/verbose 0

# ── Detector geometry ────────────────────────────────────────
# Uncomment and set the desired top-SiPM pitch before initializing.
# The number of active top SiPMs is computed automatically.
#/det/topSiPMPitch 50 mm   # 5 cm pitch
#/det/topSiPMPitch 80 mm   # 8 cm pitch
/det/scintillatorMaterial EJ230

/run/initialize

# ── SiPM model/electronics ───────────────────────────────────
# Supported examples:
#   Broadcom / AFBR-S4N66P024M
#   S14160-6010PS  (Hamamatsu S14160, 10 um pixels)
#   S14160-6015PS  (Hamamatsu S14160, 15 um pixels)
#   Hamamatsu / S13360-6025  (legacy curve)
/sipm/sensorModel Broadcom
#/sipm/sptrSigma 0.030 ns
#/sipm/electronicsSigma 0.030 ns

# ── Muon gun ─────────────────────────────────────────────────
/gun/particle  mu-
/gun/energy    1 GeV
/muon/angle    0

# Loop: positions from -650 to +650 mm, step 65 mm
/control/loop macros/scan_step.mac xpos -650 650 65
