# ============================================================
# scan.mac — longitudinal scan along the bar (x-axis)
# Usage: ./ej200_bar_sim -m macros/scan.mac
# ============================================================

/control/verbose 0
/run/verbose     0
/event/verbose   0
/tracking/verbose 0

# ── Detector geometry/material/sensor ────────────────────────
# /det/scintillator OPSC-101
# /sipm/model AFBR-S4N66P024M

/run/initialize

# ── SiPM electronics ─────────────────────────────────────────
#/sipm/jitterSigma 0.020 ns

# ── Muon gun ─────────────────────────────────────────────────
/gun/particle  mu-
/gun/energy    1 GeV
/muon/angle    0

# Loop: positions from -650 to +650 mm, step 65 mm
/control/loop macros/scan_step.mac xpos -650 650 65
