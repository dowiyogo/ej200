# ============================================================
# event_display_top_midpoint.mac - visualize photon propagation
# when a muon crosses between top SiPMs 34 and 35 (central gap).
#
# Usage: ./ej200_bar_sim -m macros/event_display_top_midpoint.mac
# Interactive Qt session opens; use File > Save As... to export.
# ============================================================

/control/verbose 0
/run/verbose     0
/event/verbose   0
/tracking/verbose 0

/run/initialize

# Visualization
/vis/open OGL 1600x900-0+0
/vis/viewer/set/background white
/vis/drawVolume
/vis/scene/add/axes 0 0 0 100 mm
/vis/scene/add/eventID

# Trajectories: store and color by particle ID
/tracking/storeTrajectory 1
/vis/scene/add/trajectories smooth
/vis/modeling/trajectories/create/drawByParticleID
/vis/modeling/trajectories/drawByParticleID-0/set opticalphoton cyan
/vis/modeling/trajectories/drawByParticleID-0/set mu-           red
/vis/modeling/trajectories/drawByParticleID-0/set e-            yellow
/vis/modeling/trajectories/drawByParticleID-0/set gamma         green

# Highlight detected photons by adding hit markers
/vis/scene/add/hits

# Accumulate trajectories (single event for clarity)
/vis/scene/endOfEventAction accumulate 1

# Camera: top view, looking down +Y to see XZ plane
/vis/viewer/set/upVector 0 0 1
/vis/viewer/set/viewpointVector 0 1 0
/vis/viewer/set/projection orthogonal

# Gun: 1 GeV muon at midpoint between SiPMs 34 and 35
/gun/particle  mu-
/gun/energy    1 GeV
/muon/midpointSiPMs 34 35
/muon/angle    0

/run/beamOn 1
