# ============================================================
# run.mac — standard production run
# Usage: ./ej200_bar_sim -m macros/run.mac
# ============================================================

/control/verbose 0
/run/verbose     0
/event/verbose   0
/tracking/verbose 0

# ── Detector geometry ────────────────────────────────────────
# Top SiPM pitch (triggers ReinitializeGeometry).
# Valid range: ~10–73 mm for 20 SiPMs within the 1.4 m bar.
# Common values: 40, 50, 70 (default), 80 mm
#/det/topSiPMPitch 70 mm
/det/scintillatorMaterial EJ230

/run/initialize

# ── SiPM model/electronics ───────────────────────────────────
# Supported examples:
#   Broadcom / AFBR-S4N66P024M
#   S14160-6010PS  (Hamamatsu S14160, 10 um pixels)
#   S14160-6015PS  (Hamamatsu S14160, 15 um pixels)
#   Hamamatsu / S13360-6025  (legacy curve)
/sipm/sensorModel Broadcom
#/sipm/sptrSigma 0.030 ns
#/sipm/electronicsSigma 0.030 ns

# ── Muon gun ─────────────────────────────────────────────────
/gun/particle  mu-
/gun/energy    1 GeV

# Option A — direct position + vertical incidence (default)
/muon/angle    0
/muon/gunX     0 mm

# Option B — midpoint between two top SiPMs (uncomment to use)
# /muon/midpointSiPMs 9 10

# Option C — tilted muon (angle in degrees from -Z vertical)
# /muon/angle 30

/run/beamOn 1000
