# ============================================================
# scan_edge.mac — fine x-scan toward bar edge (10 mm step)
# Usage: ./ej200_bar_sim -m macros/scan_edge.mac
#
# Scans x from +600 mm to +700 mm in 10 mm steps (11 positions,
# 500 events each). Enters the last 5 cm of the bar to study
# light loss and timing degradation in the edge scattering regime.
# ============================================================

/control/verbose 0
/run/verbose     0
/event/verbose   0
/tracking/verbose 0

/run/initialize

/gun/particle  mu-
/gun/energy    1 GeV
/muon/angle    0

# 11 positions: 600, 610, 620, ..., 700 mm
/control/loop macros/scan_edge_step.mac xpos 600 700 10
