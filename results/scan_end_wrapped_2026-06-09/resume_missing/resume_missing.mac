# CODEX_EXEC_03b: high-statistics position scan.
# Reproducibility requires the fixed 16-thread configuration and the
# per-position seed pairs below.
/control/verbose 0
/run/verbose 0
/event/verbose 0
/tracking/verbose 0
/run/numberOfThreads 16

/det/readout End
/det/scintillatorMaterial EJ204
/run/initialize
/sipm/jitterSigma 0 ns

/gun/particle mu-
/gun/energy 1 GeV
/muon/angle 0

# x = -150 mm, seeds = 322109 722159
/random/setSeeds 322109 722159
/muon/gunX -150 mm
/run/beamOn 10000
# x = -100 mm, seeds = 323118 723172
/random/setSeeds 323118 723172
/muon/gunX -100 mm
/run/beamOn 10000
